{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://activi.local/schemas/source-record.schema.json",
  "title": "SourceRecord",
  "type": "object",
  "required": ["source_id", "name", "type", "status"],
  "additionalProperties": true,
  "properties": {
    "source_id": { "type": "string" },
    "name": { "type": "string" },
    "type": {
      "enum": [
        "official_docs",
        "api_reference",
        "changelog",
        "standard",
        "community",
        "internal"
      ]
    },
    "topics": { "type": "array", "items": { "type": "string" } },
    "status": {
      "enum": [
        "candidate",
        "probation",
        "trusted",
        "watch",
        "deprecated",
        "removed"
      ]
    },
    "authority": { "type": "number", "minimum": 0, "maximum": 1 },
    "freshness_policy": { "type": "string" },
    "access": { "type": "string" },
    "license_policy": { "type": "string" },
    "url": { "type": "string" },
    "last_checked_at": { "type": "string" }
  }
}
