{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://activi.local/schemas/change-candidate.schema.json",
  "title": "ChangeCandidate",
  "type": "object",
  "required": ["candidate_id", "skill_id", "risk", "status"],
  "additionalProperties": true,
  "properties": {
    "candidate_id": { "type": "string" },
    "skill_id": { "type": "string" },
    "base_version": { "type": "string" },
    "change_type": { "type": "string" },
    "risk": { "enum": ["A", "B", "C"] },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "proposed_files": { "type": "array", "items": { "type": "string" } },
    "expected_effects": { "type": "array", "items": { "type": "string" } },
    "required_evals": { "type": "array", "items": { "type": "string" } },
    "status": {
      "enum": [
        "draft",
        "ready_for_build",
        "built",
        "eval_failed",
        "ready_for_pr",
        "rejected"
      ]
    }
  }
}
