{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://activi.local/schemas/evidence.schema.json",
  "title": "EvidenceRecord",
  "type": "object",
  "required": ["evidence_id", "claim", "source_id", "status"],
  "additionalProperties": true,
  "properties": {
    "evidence_id": { "type": "string" },
    "claim": { "type": "string", "minLength": 4 },
    "source_id": { "type": "string" },
    "source_snapshot": { "type": "string" },
    "source_type": { "type": "string" },
    "published_at": { "type": "string" },
    "retrieved_at": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "authority": { "type": "number", "minimum": 0, "maximum": 1 },
    "corroboration": { "type": "integer", "minimum": 0 },
    "conflicts": { "type": "array" },
    "affects": { "type": "array", "items": { "type": "string" } },
    "status": {
      "enum": ["unverified", "verified", "conflicted", "rejected"]
    }
  }
}
